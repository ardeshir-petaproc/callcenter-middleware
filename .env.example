# --- Core -----------------------------------------------------------------
HTTP_PORT=8080
DB_PATH=/data/callcenter.db
# Long random string; tokens are invalidated when it changes.
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12
# Created only when the user table is empty. Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# true = sample queues, agents (password agent123), flows, AI profile and history.
SEED_DEMO=false
# Comma separated origins allowed for CORS (desktop app, dev servers). Same-origin needs nothing.
CORS_ORIGINS=

# --- Asterisk ARI ---------------------------------------------------------
ARI_URL=http://172.28.0.20:8088/ari
ARI_WS_URL=ws://172.28.0.20:8088/ari/events
# For the simulator profile use:
# ARI_URL=http://172.28.0.30:8088/ari
# ARI_WS_URL=ws://172.28.0.30:8088/ari/events
ARI_USERNAME=callcenter-app
ARI_PASSWORD=pbx_ari_secret_2026
ARI_APP=callcenter-app

# --- Fail-open / legacy dialplan routing -----------------------------------
DEFAULT_QUEUE=600
QUEUE_CONTEXT=ext-queues
# Used only when no IVR flow is configured in the panel.
QUEUE_MAPPINGS=1=600,2=601,0=600
GREETING_MEDIA=sound:custom/ivr-welcome
IVR_TIMEOUT_SEC=5
MAX_RETRIES=2
DRAIN_TIMEOUT_SEC=10
# Legacy screen-pop webhook (POST on every queue handoff). Prefer panel webhooks.
WEBHOOK_URL=

# --- ACD ------------------------------------------------------------------
DEFAULT_RING_TIMEOUT_SEC=20
DEFAULT_WRAPUP_SEC=10
AUTO_PAUSE_MISSES=3
VOICEMAIL_MAX_SEC=120
VOICEMAIL_MEDIA=sound:vm-intro
CALLBACK_MEDIA=sound:custom/callback-confirm
CLOSED_MEDIA=sound:custom/closed

# --- Outbound / click-to-call ----------------------------------------------
OUTBOUND_DIAL_TEMPLATE=PJSIP/{number}@trunk
OUTBOUND_CALLER_ID='"Acme Support" <+15550000>'

# --- OpenAI voice agent -----------------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# RTP ports used by ExternalMedia; must be reachable from Asterisk.
MEDIA_BIND_HOST=0.0.0.0
MEDIA_ADVERTISE_HOST=172.28.0.10
MEDIA_PORT_MIN=40000
MEDIA_PORT_MAX=40199

# --- Platform: storage, encryption, Joow ------------------------------------
# Encrypted knowledge files live here; without DATA_ENCRYPTION_KEY a key file
# (.data-key) is generated in this directory - back it up with the database.
# DATA_DIR=data   (the Docker image uses /data)
DATA_ENCRYPTION_KEY=
# Base URL of the panel, used in invitation links.
PUBLIC_URL=http://localhost:8080
# local = built-in development provider; http = real Joow API.
JOOW_MODE=local
JOOW_API_URL=
JOOW_API_KEY=
